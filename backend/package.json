{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Portfolio REST API — Express + MongoDB",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:e2e": "dotenv -e .env.e2e -- node src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:e2e": "dotenv -e .env.e2e -- node src/seed.js",
    "migrate": "node src/migrations/run.js",
    "migrate:status": "node src/migrations/run.js --status",
    "migrate:dry": "node src/migrations/run.js --dry-run",
    "migrate:baseline": "node src/migrations/run.js --baseline",
    "migrate:verify": "node scripts/verify-migrations-idempotent.js",
    "test": "node scripts/run-jest.js --detectOpenHandles --forceExit",
    "test:coverage": "node scripts/run-jest.js --coverage --detectOpenHandles --forceExit",
    "test:watch": "node scripts/run-jest.js --watch",
    "test:atlas": "node scripts/run-jest.js --runInBand --detectOpenHandles --forceExit --atlas",
    "admin:password": "node scripts/set-admin-password.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/src/__tests__/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/src/__tests__/setup/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/src/__tests__/setup/perWorkerDatabase.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 60,
        "functions": 70,
        "lines": 70
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/seed.js"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "~7.5.0",
    "mongoose": "~9.9.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  }
}
