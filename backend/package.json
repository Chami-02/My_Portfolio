{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Portfolio REST API \u2014 Express + MongoDB",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:e2e": "dotenv -e .env.e2e -- node src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:e2e": "dotenv -e .env.e2e -- node src/seed.js",
    "test": "node scripts/run-jest.js --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "node scripts/run-jest.js --coverage --runInBand --detectOpenHandles --forceExit",
    "test:watch": "node scripts/run-jest.js --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 60,
        "functions": 70,
        "lines": 70
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/seed.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.7.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
