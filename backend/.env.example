NODE_ENV=production

# Local development only (server.js) — not needed on Vercel
PORT=5050

# The database name (the path after the host) is REQUIRED — without it the
# driver silently connects to a database called "test". See PF-66.
#
# Four databases, by convention (adopted 2026-08-31 — see CLAUDE.md):
#   portfolio_prod   the live site        (Vercel's MONGO_URI)
#   portfolio_dev    your local machine   (this file, backend/.env)
#   portfolio_test   the Jest suite       (npm test rewrites the URI to it)
#   portfolio_e2e    the Playwright suite (.env.e2e)
# Deliberately no staging database — ceremony a solo project doesn't need.
#
# ⚠️ Before 2026-08-31 the live database was actually named "test" — an
# accident of the missing-path default above, not a choice (confirmed by
# document count, not by name, 2026-08-29/30). It's now retired as a
# two-week rollback; drop it after ~2026-09-14 if nothing has surfaced.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>

# Optional — point `npm test` at a different database. When unset, tests reuse
# MONGO_URI with the database name swapped to "portfolio_test".
TEST_MONGO_URI=

JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (PF-63) — get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
