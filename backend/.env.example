NODE_ENV=production

# Local development only (server.js) — not needed on Vercel
PORT=5050

# The database name (the path after the host) is REQUIRED — without it the
# driver silently connects to a database called "test". See PF-66.
#
# ⚠️ On THIS project's Atlas cluster that already happened, and the outcome
# is the opposite of what it looks like: the live database really is named
# "test", and it is the correct, current one. A "portfolio" database also
# exists on the cluster but is an abandoned copy from 2026-07-18, missing
# the `vocabularies` (32 docs) and `contacts` collections entirely.
#
# So do NOT "tidy" a working .env by repointing /test → /portfolio. That
# silently rolls the site back three weeks and drops two collections, with
# no error — the app connects happily to either. Checked 2026-08-18;
# re-check with a document count before changing it, never by name alone.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>

# Optional — point `npm test` at a different database. When unset, tests reuse
# MONGO_URI with the database name swapped to "portfolio_test".
TEST_MONGO_URI=

JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (PF-63) — get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio
