# E2E test environment — PF-66
#
# Copy to .env.e2e and fill in the cluster credentials. The real file is
# gitignored; this example is committed so the setup is reproducible.
#
# Its own database and its own port so the Playwright suite can
# never touch development or production data.

NODE_ENV=test
PORT=5055

# Same cluster as .env, isolated database. The database name is REQUIRED —
# without it the driver silently connects to a database called "test",
# which is where production data lives. See PF-66.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/portfolio_e2e?retryWrites=true&w=majority&appName=<app-name>

JWT_SECRET=e2e-only-secret-not-used-anywhere-else

# Admin password. Left blank on purpose — no credential belongs in a
# committed file. Blank is also a working default: seed.js falls back to
# its local-development demo password, which is what frontend/e2e/admin.spec.js
# falls back to as well, so the suite passes without it being set here.
# The admin's ADDRESSES are fixed (PF-119): pcgallege@gmail.com, plus
# parindrachameekara@gmail.com as a second login address.
SEED_ADMIN_PASSWORD=

# Google sign-in (PF-119) — PLACEHOLDERS, deliberately not real values.
# They let /api/auth/google/start build a Google URL; admin.spec.js stops
# the browser before it reaches Google. Never put the real client here.
GOOGLE_CLIENT_ID=e2e-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=e2e-placeholder-not-a-secret
GOOGLE_REDIRECT_URI=http://localhost:5055/api/auth/google/callback
FRONTEND_URL=http://localhost:5174

# Cloudinary intentionally blank — E2E must not hit a real CDN
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=e2e
