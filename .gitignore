.vercel

# Database backups (PF-52) — never commit a database dump
backups/

# Local DNS workaround for mongodb+srv:// lookups — machine-specific, not a project dependency
backend/dns-fix.local.js

# Local environment files with real secrets — never commit these
# (`.env` does not match `.env.e2e`, so the E2E file needs its own line.
#  `.env.e2e.example` stays tracked — the pattern is an exact name match.)
.env
.env.local
.env.e2e
.env.e2e
